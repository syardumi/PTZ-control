{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTZ Control",
  "version": "1.0.0",
  "identifier": "com.ptzcontrol.client",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      { "title": "PTZ Control", "width": 480, "height": 900, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
