{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTZ Control Server",
  "version": "1.0.0",
  "identifier": "com.ptzcontrol.server",
  "build": {
    "beforeBuildCommand": "npm run build:sidecar",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": { "capabilities": ["default"] }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "externalBin": ["binaries/ptz-server", "binaries/ffmpeg"],
    "macOS": { "minimumSystemVersion": "10.15" }
  },
  "plugins": {
    "shell": {
      "scope": [
        { "name": "binaries/ptz-server", "sidecar": true },
        { "name": "binaries/ffmpeg", "sidecar": true }
      ]
    }
  }
}
